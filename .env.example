# RugShield configuration.
# Copy to `.env.local` and fill in. Never commit the filled-in file.

# ---------------------------------------------------------------------------
# Solana RPC
# ---------------------------------------------------------------------------
# Optional. Defaults to the public mainnet-beta endpoint, which works but is
# heavily rate limited: `getTokenLargestAccounts` is rejected there, so the
# holder-distribution check reports "unavailable". Set a dedicated endpoint
# (Helius, QuickNode, Triton, your own validator) to enable it.
SOLANA_RPC_URL=

# ---------------------------------------------------------------------------
# Risk engine tuning (all optional)
# ---------------------------------------------------------------------------
# Per-request timeout for upstream APIs, in ms. Default 12000.
RUGSHIELD_TIMEOUT_MS=
# Probe size for the buy/sell round-trip quote, in lamports. Default 100000000
# (0.1 SOL). Large enough to route, small enough not to distort price impact.
RUGSHIELD_PROBE_LAMPORTS=
# Override the market/routing providers if you proxy them.
RUGSHIELD_DEXSCREENER_BASE_URL=
RUGSHIELD_JUPITER_BASE_URL=
# Where the JSON scan history lives. Default ./data/scans.json
RUGSHIELD_STORE_PATH=

# ---------------------------------------------------------------------------
# x402 pay-per-call (disabled by default)
# ---------------------------------------------------------------------------
# With X402_ENABLED unset or false, /api/check is free and the rest of this
# block is ignored. Set it to true and POST /api/check answers HTTP 402 with
# x402 payment requirements until a valid X-PAYMENT header arrives.
#
# If enabled, X402_PAY_TO and X402_FACILITATOR_URL are mandatory: the route
# fails closed with HTTP 500 rather than silently serving scans for free.
X402_ENABLED=false

# CAIP-style network id. `solana:devnet` or `solana:mainnet`.
X402_NETWORK=solana:devnet

# Address that receives the USDC. Required when enabled.
X402_PAY_TO=

# Price per call, human units. Default 0.01 (one US cent).
X402_PRICE_USDC=0.01

# Payment token mint. Leave empty to use the known USDC mint for X402_NETWORK.
X402_ASSET=
X402_ASSET_DECIMALS=6

# Facilitator that verifies and settles payments on-chain. Required when
# enabled. RugShield never holds a private key: it only calls /verify and
# /settle on this service.
X402_FACILITATOR_URL=

# Only if your facilitator requires a bearer token.
X402_FACILITATOR_API_KEY=

# How long a payment authorization stays valid, in seconds. Default 120.
X402_MAX_TIMEOUT_SECONDS=
